header: "LoginForm.h"
[Nested] enum class WebKit::LoginFormField::Role : uint8_t {
    Username,
    Password,
    NewPassword,
};

[CustomHeader] struct WebKit::LoginFormField {
    WebKit::LoginFormField::Role role;
    WebCore::ElementContext element;
    String value;
    String name;
    String idAttribute;
    String type;
    String autocomplete;
    String placeholder;
    String label;
};

struct WebKit::LoginForm {
    WebCore::FrameIdentifier frameID;
    Vector<WebKit::LoginFormField> fields;
    std::optional<uint32_t> focusedField;
};
